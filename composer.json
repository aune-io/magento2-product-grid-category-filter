{
    "name": "aune-io/magento2-product-grid-category-filter",
    "description": "Product grid category filter for Magento 2",
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "103.0.*",
        "magento/module-catalog": "104.0.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "type": "magento2-module",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Aune\\ProductGridCategoryFilter\\": ""
        }
    }
}
